{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": ["src/**/*", "../backend/preload.d.ts", "../shared/**/*"],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "jsx": "react-jsx",
    "baseUrl": "..",
    "paths": {
      "@frontend/*": ["frontend/src/*"],
      "@shared/*": ["shared/*"]
    }
  }
}
